{
  "version": 1,
  "sdk_version": "0.23.0",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "train-ticket-intel-mcp",
      "version": "0.2.0",
      "title": "火车票情报中台 MCP"
    },
    "tools": [
      {
        "name": "get_overview",
        "title": "获取情报中台总览",
        "description": "返回本轮流水线的总览：运行信息、源覆盖、证据与事件数量、风险分布、最高优先级事件的一句话结论（含参考意见）。",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_daily_brief",
        "title": "获取日报（Markdown）",
        "description": "直接返回由数据生成的 Markdown 日报：一句话结论、运行概况、高优先级事件与参考意见、影响矩阵、建议动作、待确认事项、证据清单、方法与边界。",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "type": {
              "description": "报告类型，默认 daily",
              "type": "string",
              "enum": ["daily", "weekly", "topic"]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_sources",
        "title": "列出所有信息源",
        "description": "返回信息源注册表：权威级别、访问方式、连接状态、抓取策略，以及本轮该源的真实产出（原文数/有效证据数/去重数）。",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "按情报类型过滤：policy=政策监管, competitor=功能竞品, sentiment=舆论反馈",
              "type": "string",
              "enum": ["policy", "competitor", "sentiment"]
            },
            "connectionStatus": {
              "description": "按连接状态过滤，例如只看 connected 的源",
              "type": "string",
              "enum": [
                "unconfigured",
                "testing",
                "connected",
                "degraded",
                "auth_required",
                "login_required",
                "blocked",
                "failed",
                "disabled"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_evidence",
        "title": "检索原文证据",
        "description": "返回证据库条目：评分拆解（权威度/可核验/多源印证/时效/密度）、校验状态、是否可作为政策依据、冲突对象。可按分类、来源、最低分或校验状态过滤。",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "description": "按情报分类过滤",
              "type": "string",
              "enum": ["policy", "competitor", "sentiment"]
            },
            "sourceId": {
              "description": "按来源 ID 过滤，例如 src-01",
              "type": "string"
            },
            "minScore": {
              "description": "只返回总分不低于该值的证据",
              "type": "number"
            },
            "verificationStatus": {
              "description": "按校验状态过滤",
              "type": "string",
              "enum": [
                "unverified",
                "verifying",
                "verified_online",
                "verified_snapshot",
                "lead_only",
                "conflict",
                "blocked",
                "obsolete"
              ]
            },
            "limit": {
              "description": "返回条数上限，默认 10",
              "type": "number"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_events",
        "title": "列出情报事件",
        "description": "返回引擎现场聚合出的情报事件，含风险等级、置信度、参考意见立场与影响模块。可按等级/状态/类型/立场过滤。",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "riskLevel": {
              "description": "按风险等级过滤",
              "type": "string",
              "enum": ["P1", "P2", "P3"]
            },
            "status": {
              "description": "按事件工作流状态过滤",
              "type": "string",
              "enum": [
                "new",
                "evidence_check",
                "human_review",
                "confirmed",
                "product_review",
                "action_planned",
                "assigned",
                "in_progress",
                "effect_review",
                "closed",
                "watching",
                "invalid_lead"
              ]
            },
            "eventType": {
              "description": "按事件类型过滤",
              "type": "string",
              "enum": [
                "policy_change",
                "competitor_feature",
                "sentiment_hot",
                "complaint_spike",
                "regulatory_risk",
                "product_opportunity"
              ]
            },
            "stance": {
              "description": "按参考意见立场过滤",
              "type": "string",
              "enum": ["act", "watch", "hold"]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_event",
        "title": "获取情报事件详情",
        "description": "根据 eventId 返回完整情报事件：参考意见（立场/依据/证伪条件/验证动作/使用边界）、评分时间线、冲突标记、产品影响矩阵与展开的证据原文。",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "eventId": {
              "description": "情报事件 ID，例如 evt_xxx（可由 list_events 获取）",
              "type": "string"
            }
          },
          "required": ["eventId"]
        },
        "outputSchema": null
      }
    ]
  }
}
